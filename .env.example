# Application
ENVIRONMENT=development
APP_URL=http://localhost:8787

# Security & Tokens
JWT_ISSUER=https://auth.local
JWT_AUDIENCE=hono-auth-client
COOKIE_SECRET=super-secret-cookie-encryption-key-min-32-chars-long
# Cookie domain for sharing sessions across subdomains (e.g. ".yourdomain.com"). Leave blank for localhost/single-host.
COOKIE_DOMAIN=""
ADMIN_SECRET_KEY=sk_test_hono_auth_secret_key_123456789

# JWKS Keys (Base64-encoded or PEM, generated automatically if not provided)
JWT_PRIVATE_KEY_PEM=""
JWT_PUBLIC_KEY_PEM=""

# Third-Party Social OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=http://localhost:8787/v1/client/oauth/google/callback

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI=http://localhost:8787/v1/client/oauth/github/callback

# Webhooks (Optional)
WEBHOOK_SECRET=whsec_test_secret_key
