# Application
ENVIRONMENT=development
APP_URL=http://localhost:8787
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=super-secret-better-auth-key-min-32-chars-long-12345

# Security & Cookies
COOKIE_SECRET=super-secret-cookie-encryption-key-min-32-chars-long
COOKIE_DOMAIN=""

# Admin Bootstrapping (emails separados por vírgula que ganham role 'admin' automaticamente no signup)
ADMIN_EMAILS="admin@exemplo.com"

# Social OAuth (Plug-and-play: preencha as que for usar, as vazias ficam desativadas)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Email Service (Resend - opcional; se vazio exibe os links no console de desenvolvimento)
RESEND_API_KEY=""
FROM_EMAIL="onboarding@resend.dev"

# Webhooks (Opcional - Notificações em tempo real assinadas com HMAC-SHA256)
WEBHOOK_URL=""
WEBHOOK_SECRET=whsec_test_secret_key_123456
