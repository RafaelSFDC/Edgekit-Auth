{
  "name": "edgekit-auth",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "High-Performance Edge Authentication Engine built on Hono, Better Auth and Cloudflare Workers — Edgekit Auth",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"indigo,cyan\" \"pnpm --filter @edgekit/api dev\" \"pnpm --filter @edgekit/web dev\"",
    "dev:api": "pnpm --filter @edgekit/api dev",
    "dev:web": "pnpm --filter @edgekit/web dev",
    "setup": "node scripts/setup.mjs",
    "build:web": "pnpm --filter @edgekit/web build",
    "build:api": "pnpm --filter @edgekit/api build",
    "build": "pnpm --filter @edgekit/web build && pnpm --filter @edgekit/api build",
    "deploy": "pnpm --filter @edgekit/web build && pnpm --filter @edgekit/api deploy",
    "cf-typegen": "pnpm --filter @edgekit/api cf-typegen",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm -r run test",
    "test:api": "pnpm --filter @edgekit/api test",
    "test:web": "pnpm --filter @edgekit/web test",
    "db:generate": "pnpm --filter @edgekit/api db:generate",
    "db:migrate:local": "pnpm --filter @edgekit/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @edgekit/api db:migrate:remote",
    "admin:create": "pnpm --filter @edgekit/api admin:create",
    "admin:promote": "pnpm --filter @edgekit/api admin:promote",
    "admin:list": "pnpm --filter @edgekit/api admin:list"
  },
  "keywords": [
    "edgekit",
    "auth",
    "better-auth",
    "cloudflare",
    "workers",
    "d1",
    "hono",
    "serverless",
    "passkeys",
    "rbac"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "oxc-transform-react": "^0.156.0",
    "oxlint": "^1.90.0"
  }
}
