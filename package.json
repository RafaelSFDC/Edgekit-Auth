{
  "name": "edgekit-auth",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "High-Performance Edge Authentication Engine built on Hono, Better Auth and Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan,magenta\" \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:api": "wrangler dev",
    "dev:web": "pnpm --filter dashboard dev",
    "build:web": "pnpm --filter dashboard build",
    "build": "pnpm build:web && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm build:web && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hono-auth-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hono-auth-db --remote",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "admin:promote": "node --experimental-strip-types scripts/create-admin.ts",
    "admin:list": "node --experimental-strip-types scripts/create-admin.ts --list",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@better-auth/passkey": "^1.7.14",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.4",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.2",
    "jose": "^5.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
